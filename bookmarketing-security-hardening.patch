 export const redis = createRedisClient();
+
+export async function acquireDistributedLock(key: string, ttlMs: number): Promise<string | null> {
+  if (!config.redis.enabled) return null;
+  const token = `${process.pid}:${Date.now()}:${Math.random().toString(36).slice(2)}`;
+  try {
+    const result = await redis.set(key, token, 'PX', ttlMs, 'NX');
+    return result === 'OK' ? token : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function releaseDistributedLock(key: string, token: string): Promise<void> {
+  if (!config.redis.enabled) return;
+  try {
+    await redis.eval(
+      "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end",
+      1, key, token
+    );
+  } catch { /* best effort; TTL remains the safety net */ }
+}
