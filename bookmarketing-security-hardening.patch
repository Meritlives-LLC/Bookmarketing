+BLOCKED.addCIDRs([
++  '0.0.0.0/8', '100.64.0.0/10', '192.0.0.0/24', '192.0.2.0/24',
+  '198.18.0.0/15', '198.51.100.0/24', '203.0.113.0/24', '224.0.0.0/4',
+  '240.0.0.0/4', '2001:db8::/32', 'ff00::/8', '100::/64', '2001:20::/28',
+  '2002::/16', '2001::/32', '64:ff9b::/96', '64:ff9b:1::/48',
+]);
+
+export const GOODREADS_HOSTS = new Set(['goodreads.com', 'www.goodreads.com']);
+export const AMAZON_HOSTS = new Set([
+  'amazon.com', 'www.amazon.com', 'smile.amazon.com',
+  'amazon.co.uk', 'www.amazon.co.uk', 'amazon.ca', 'www.amazon.ca',
+  'amazon.com.au', 'www.amazon.com.au', 'amazon.de', 'www.amazon.de',
+  'amazon.fr', 'www.amazon.fr', 'amazon.es', 'www.amazon.es',
+  'amazon.it', 'www.amazon.it', 'amazon.in', 'www.amazon.in',
+]);
+
+function isBlockedIp(address: string, family: number): boolean {
+  if (net.isIP(address) === 0) return true;
+  return BLOCKED.check(address, family === 6 ? 'ipv6' : 'ipv4');
+}
+
+export async function validateOutboundUrl(raw: string, allowedHosts: ReadonlySet<string>): Promise<URL> {
+  let url: URL;
+  try { url = new URL(raw); } catch { throw AppError.badRequest('Invalid external URL', 'INVALID_EXTERNAL_URL'); }
+  if (url.protocol !== 'https:' || url.username || url.password || url.port) {
+    throw AppError.badRequest('External URL must use HTTPS without credentials or a custom port', 'INVALID_EXTERNAL_URL');
+  }
+  const hostname = url.hostname.toLowerCase().replace(/\.$/, '');
+  if (!allowedHosts.has(hostname)) {
+    throw AppError.badRequest('External URL host is not allowed', 'EXTERNAL_HOST_NOT_ALLOWED');
+  }
+  const records = await dns.lookup(hostname, { all: true, verbatim: true });
+  if (!records.length || records.some((r) => isBlockedIp(r.address, r.family))) {
+    throw AppError.badRequest('External URL resolves to a blocked network address', 'SSRF_BLOCKED');
+  }
+  return url;
+}
