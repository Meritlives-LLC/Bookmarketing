# Local dev only (two processes, two ports). For the single-URL deploy
# (see DEPLOYMENT.md at repo root) leave this UNSET, or set it to the
# relative path "/api/v1" — lib/api/client.ts then calls the
# API same-origin and next.config.mjs's rewrite proxies it to the
# backend server-side. An absolute host like this only works when the
# browser itself can reach that host, which isn't true once this is
# built and deployed anywhere but your own machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Stripe price IDs (public/publishable IDs, safe for the client bundle).
# Must match STRIPE_PRICE_STARTER / STRIPE_PRICE_PRO / STRIPE_PRICE_AGENCY on the backend.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=


VIDEO_MEDIA_ALLOWED_HOSTS=generativelanguage.googleapis.com,storage.googleapis.com,*.googleusercontent.com
COVER_IMAGE_ALLOWED_HOSTS=covers.openlibrary.org,*.openlibrary.org,books.google.com,*.googleusercontent.com,i.gr-assets.com,images.gr-assets.com,*.goodreads.com,m.media-amazon.com,*.ssl-images-amazon.com
VIDEO_ALLOWED_MODELS=veo-2.0-generate-001