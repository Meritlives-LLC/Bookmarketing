FROM node:20.10.0-alpine AS base
WORKDIR /app

# ── deps ──────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json* ./
RUN npm ci

# ── build ─────────────────────────────────────────────────────────────
# Build-time envs: NEXT_PUBLIC_* values are baked into the client bundle,
# so they must be present at build time, not just at runtime. In the
# combined-container/single-origin setup, NEXT_PUBLIC_API_URL should stay
# unset (or "/api/v1") so the browser calls same-origin and the rewrite in
# next.config.mjs (BACKEND_INTERNAL_URL, a runtime env) forwards it to the
# api container — no rebuild needed to point at a different backend host.
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ── runtime ───────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

RUN apk add --no-cache curl \
  && addgroup -S app && adduser -S app -G app

# `output: "standalone"` (next.config.mjs) traces the minimal server +
# node_modules needed to run, so the runtime image doesn't carry the full
# dependency tree from `deps`/`build`.
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

RUN chown -R app:app /app
USER app

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fs http://localhost:3000/ || exit 1

# server.js is generated by the standalone output — it runs `next start`
# equivalent, honoring $PORT and the BACKEND_INTERNAL_URL rewrite target.
CMD ["node", "server.js"]
