  STATIC
  PAN_LEFT
  PAN_RIGHT
  TILT_UP
  TILT_DOWN
  DOLLY_IN
  DOLLY_OUT
  PUSH_IN
  PULL_OUT
  TRACKING
  FOLLOW
  ORBIT
  ARC
  CRANE_UP
  CRANE_DOWN
  BOOM_UP
  BOOM_DOWN
  HANDHELD
  STEADICAM
  GIMBAL
  ZOOM_IN
  ZOOM_OUT
  WHIP_PAN
  DRONE_RISE
  DRONE_DESCEND
  DRONE_FORWARD
  DRONE_BACKWARD
  DOLLY_ZOOM
  POV
  FIRST_PERSON
  CUSTOM
}

enum CameraSpeed {
  VERY_SLOW
  SLOW
  MEDIUM
  FAST
  VERY_FAST
}

enum CameraRig {
  STATIC_TRIPOD
  HANDHELD
  STEADICAM
  GIMBAL
  DOLLY
  CRANE
  JIB
  DRONE
  SHOULDER
  POV
  UNKNOWN
}

enum CameraAngle {
  EYE_LEVEL
  LOW_ANGLE
  HIGH_ANGLE
  BIRDS_EYE
  WORMS_EYE
  DUTCH_ANGLE
  OVERHEAD
  GROUND_LEVEL
  OVER_SHOULDER
  TOP_DOWN
  BOTTOM_UP
  POV
  PROFILE
  THREE_QUARTER
}

enum CameraFraming {
  EXTREME_WIDE
  WIDE
  FULL
  MEDIUM_WIDE
  MEDIUM
  MEDIUM_CLOSE_UP
  CLOSE_UP
  EXTREME_CLOSE_UP
  TWO_SHOT
  OVER_SHOULDER
  INSERT
  CUTAWAY
  POV_FRAME
}

enum FocusMode {
  FIXED
  RACK_FOCUS
  FOLLOW_FOCUS
  DEEP_FOCUS
  SOFT_FOCUS
  SHALLOW_FOCUS
  AUTO_FOCUS
  SELECTIVE_FOCUS
}

enum DepthOfField {
  SHALLOW
  MEDIUM
  DEEP
  MODERATE
  EXTREME_SHALLOW
}

enum MovementPurpose {
  ESTABLISH_LOCATION
  FOLLOW_CHARACTER
  FOLLOW_ACTION
  BUILD_TENSION
  CREATE_INTIMACY
  CREATE_DISTANCE
  SHOW_SCALE
  REVEAL_INFORMATION
  REVEAL_CHARACTER
  REVEAL_OBJECT
  EMPHASIZE_EMOTION
  CREATE_DISORIENTATION
  TRANSITION
}

model VideoShot {
  id                   String            @id @default(uuid())
  sceneId              String
  scene                VideoScene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotNumber           Int
  shotType             String?
  sourceTextSegment    String?
  action               String?
  /// Legacy free-text camera summary (kept for display compatibility)
  camera               String?
  /// Structured first-class cinematography
  cameraMovement       CameraMovement?
  cameraSpeed          CameraSpeed?
  cameraDirection      String?
  cameraAngle          CameraAngle?
  cameraRig            CameraRig?
  lens                 String?
  focalLength          String?
  framing              CameraFraming?
  composition          String?
  focusMode            FocusMode?
  focusTarget          String?
  depthOfField         DepthOfField?
  movementPurpose      MovementPurpose?
  /// Legacy free-text movement summary
  movement             String?
  lighting             String?
  durationSec          Float?
  startOffsetSec       Float?
  visualPrompt         String?
  negativePrompt       String?
  /// Advisory continuity warnings (never blocks generation)
  cameraContinuityWarnings Json?
  status               VideoShotStatus   @default(PENDING)
  videoUrl             String?
  providerGenerationId String?
  /// When the in-flight providerGenerationId was submitted to the provider.
  /// Used to detect stale/abandoned generations after a worker crash so they
  /// can be safely retried instead of polled forever.
  generationStartedAt  DateTime?
  lastErrorType        ProviderErrorType?
  retryCount           Int               @default(0)
  errorMessage         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([sceneId, shotNumber])
  @@index([sceneId])
  @@index([cameraMovement])
  @@index([status])
  @@index([providerGenerationId])
  @@map("video_shots")
}

model SubtitleCue {
  id             String     @id @default(uuid())
  sceneId        String
  scene          VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sequence       Int
  text           String
  startTimeMs    Int
  endTimeMs      Int
  startWordIndex Int?
  endWordIndex   Int?
  speakerLabel   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sceneId, sequence])
  @@index([sceneId])
  @@map("subtitle_cues")
}

/// Word-level timestamp from narration audio (when provider supports it).
model WordTimestamp {
  id        String     @id @default(uuid())
  sceneId   String
  scene     VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  word      String
  startMs   Int
  endMs     Int
  index     Int
  createdAt DateTime   @default(now())

  @@unique([sceneId, index])
  @@index([sceneId])
  @@map("word_timestamps")
}
