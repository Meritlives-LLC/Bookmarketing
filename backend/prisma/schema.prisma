// ─────────────────────────────────────────────────────────────
// BOOK-VIDEO (AI Book-to-Video / Film Studio) ENUMS
// ─────────────────────────────────────────────────────────────

enum ManuscriptFileType {
  PDF
  DOCX
  TXT
}

enum ExtractionStatus {
  PENDING
  EXTRACTING
  COMPLETED
  FAILED
}

enum VideoProjectStatus {
  DRAFT
  ANALYZING
  PLANNING
  GENERATING_REFERENCES
  GENERATING_SCENES
  GENERATING_VIDEO
  GENERATING_SUBTITLES
  ASSEMBLING
  COMPLETED
  FAILED
  CANCELED
  PAUSED
}

enum SubtitleMode {
  OFF
  SOFT
  BURNED_IN
}

enum SubtitleStyle {
  CLASSIC
  MODERN
  CINEMATIC
  MINIMAL
  BOLD
  CUSTOM
}

enum VideoShotStatus {
  PENDING
  PROMPT_READY
  GENERATING
  RENDERED
  FAILED
}

enum VisualStyle {
  CINEMATIC_REALISM
  ANIMATION
  ANIME
  DOCUMENTARY
  FANTASY
  CUSTOM
}

enum VideoAspectRatio {
  RATIO_16_9
  RATIO_9_16
  RATIO_1_1
}

enum TextAIProviderName {
  GROQ
  LOCAL_FALLBACK
}

enum VideoProviderName {
  GEMINI_VEO
}

enum VideoSceneStatus {
  PENDING
  PROMPT_READY
  GENERATING
  RENDERED
  FAILED
  NEEDS_REVIEW
}

enum ProviderErrorType {
  TIMEOUT
  RATE_LIMIT
  SAFETY_REJECTION
  INVALID_PROMPT
  INVALID_FILE
  STORAGE_ERROR
  FFMPEG_ERROR
  DATABASE_ERROR
  UNKNOWN
}


// ─────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole  @default(AUTHOR)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpires DateTime?
  avatarUrl         String?
  credits           Int       @default(10)
  emailPreferences  Json      @default("{\"auditCompleted\": true, \"weeklyReport\": true}")
  /// Bumped on logout and password reset. Embedded in every refresh token's
  /// payload; a refresh token whose tokenVersion doesn't match the current
  /// value is rejected. Access tokens don't carry it (they're short-lived
  /// and checking it per-request would mean a DB hit on every authenticated
  /// call) — this bounds a stolen/leaked refresh token's usable lifetime to
  /// "until the user next logs out or resets their password" instead of its
  /// full 7-day expiry regardless of what the user does.
  tokenVersion      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  books         Book[]
  subscription  Subscription?
  notifications Notification[]
  apiKeys       ApiKey[]
  billingEvents BillingEvent[]

  @@index([email])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("api_keys")
}

model Subscription {
  id                   String              @id @default(uuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan    @default(FREE)
  status               SubscriptionStatus  @default(ACTIVE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("subscriptions")
}

model BillingEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Int?
  currency  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("billing_events")
}

model Book {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  subtitle      String?
  description   String
  genre         BookGenre
  coverImageUrl String?
  amazonUrl     String?
  goodreadsUrl  String?
  asin          String?
  isbn          String?
  publishedAt   DateTime?
  price         Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  audits         Audit[]
  creatives      Creative[]
  calendarEvents CalendarEvent[]
  manuscript     Manuscript?
  videoProjects  VideoProject[]

  @@index([userId])
  @@map("books")
}

model Audit {
  id             String      @id @default(uuid())
  bookId         String
  book           Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status         AuditStatus @default(PENDING)
  requestedAt    DateTime    @default(now())
  completedAt    DateTime?
  errorMessage   String?

  audienceInsights   AudienceInsight[]
  keywordSuggestions KeywordSuggestion[]
  competitorAnalyses CompetitorAnalysis[]

  @@index([bookId])
  @@map("audits")
}

model AudienceInsight {
  id           String        @id @default(uuid())
  auditId      String
  audit        Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  segment      ReaderSegment
  platform     Platform
  summary      String
  data         Json
  confidence   Float         @default(0)
  createdAt    DateTime      @default(now())

  @@index([auditId])
  @@map("audience_insights")
}

model KeywordSuggestion {
  id            String   @id @default(uuid())
  auditId       String
  audit         Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  keyword       String
  searchVolume  Int?
  suggestedBid  Decimal? @db.Decimal(10, 2)
  competition   String?
  platform      Platform @default(AMAZON)
  createdAt     DateTime @default(now())

  @@index([auditId])
  @@map("keyword_suggestions")
}

model CompetitorAnalysis {
  id             String   @id @default(uuid())
  auditId        String
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  competitorName String
  competitorAsin String?
  strengths      String[]
  weaknesses     String[]
  priceComparison Json?
  createdAt      DateTime @default(now())

  @@index([auditId])
  @@map("competitor_analyses")
}

model Creative {
  id        String         @id @default(uuid())
  bookId    String
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type      CreativeType
  segment   ReaderSegment?
  platform  Platform?
  status    CreativeStatus @default(DRAFT)
  title     String?
  content   Json
  assetUrl  String?
  variantOf String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  calendarEvents CalendarEvent[]

  @@index([bookId])
  @@index([bookId, type])
  @@map("creatives")
}

model CalendarEvent {
  id          String              @id @default(uuid())
  bookId      String
  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  creativeId  String?
  creative    Creative?           @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  platform    Platform
  scheduledAt DateTime
  status      CalendarEventStatus @default(SCHEDULED)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([bookId])
  @@index([scheduledAt])
  @@map("calendar_events")
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  bookId       String
  platform     Platform
  date         DateTime
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  spend        Decimal  @default(0) @db.Decimal(10, 2)
  revenue      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  @@unique([bookId, platform, date])
  @@index([bookId])
  @@map("analytics_snapshots")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// BOOK-VIDEO (AI Book-to-Video / Film Studio) MODELS
// ─────────────────────────────────────────────────────────────

/// One manuscript per Book. The immutable, authoritative source text —
/// never overwritten in place; a re-upload replaces it wholesale via
/// service-level delete+recreate so extractionStatus/history stays honest.
model Manuscript {
  id                     String            @id @default(uuid())
  bookId                 String            @unique
  book                   Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  originalFileName       String
  fileType               ManuscriptFileType
  fileSize               Int
  fileUrl                String
  extractionStatus       ExtractionStatus  @default(PENDING)
  extractedWordCount     Int?
  extractedCharacterCount Int?
  processingError        String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  chapters      Chapter[]
  videoProjects VideoProject[]

  @@index([bookId])
  @@index([extractionStatus])
  @@map("manuscripts")
}

/// Segmented chapters detected from a Manuscript's extracted text.
/// sourceText is the exact, immutable slice of the manuscript for this chapter.
model Chapter {
  id                  String   @id @default(uuid())
  manuscriptId        String
  manuscript          Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  chapterNumber       Int
  title               String?
  sourceText          String
  wordCount           Int
  startPosition        Int
  endPosition          Int
  extractionMetadata  Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  videoScenes VideoScene[]

  @@unique([manuscriptId, chapterNumber])
  @@index([manuscriptId])
  @@map("chapters")
}

/// A single book-to-video production run. Resumable state machine driven by `status`.
model VideoProject {
  id               String              @id @default(uuid())
  bookId           String
  book             Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  manuscriptId     String
  manuscript       Manuscript          @relation(fields: [manuscriptId], references: [id], onDelete: Restrict)
  name             String
  status           VideoProjectStatus  @default(DRAFT)
  aiProvider       TextAIProviderName  @default(GROQ)
  aiModel          String?
  videoProviderName VideoProviderName  @default(GEMINI_VEO)
  videoModel       String?
  visualStyle      VisualStyle         @default(CINEMATIC_REALISM)
  narrationVoice   String?
  aspectRatio      VideoAspectRatio    @default(RATIO_16_9)
  resolution       String?
  narrationWordsPerMinute Int          @default(150)
  subtitleEnabled  Boolean             @default(true)
  subtitleMode     SubtitleMode        @default(SOFT)
  subtitleStyle    SubtitleStyle       @default(CINEMATIC)
  subtitleConfig   Json?
  totalChapters    Int                 @default(0)
  totalScenes      Int                 @default(0)
  completedScenes  Int                 @default(0)
  progress         Float               @default(0)
  finalVideoUrl    String?
  cleanVideoUrl    String?
  subtitleVideoUrl String?
  srtUrl           String?
  vttUrl           String?
  assUrl           String?
  thumbnailUrl     String?
  errorMessage     String?
  pausedAt         DateTime?
  canceledAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  filmBible  FilmBible?
  characters VideoCharacter[]
  locations  VideoLocation[]
  props      VideoProp[]
  scenes     VideoScene[]

  @@index([bookId])
  @@index([manuscriptId])
  @@index([status])
  @@map("video_projects")
}

/// Persistent source-of-truth production bible for a VideoProject.
/// Structured JSON fields per spec §6; characters/locations/props are separate models.
model FilmBible {
  id                        String       @id @default(uuid())
  videoProjectId            String       @unique
  videoProject              VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  premise                   String?
  themes                    Json?
  genre                     String?
  tone                      String?
  visualStyleNotes          String?
  cinematography            Json?
  colorLanguage             Json?
  lighting                  Json?
  cameraLanguage            Json?
  historicalPeriod          String?
  geography                 Json?
  worldRules                Json?
  narrativeRules            Json?
  characterConsistencyRules Json?
  locationConsistencyRules  Json?
  timeline                  Json?
  rawAnalysis                Json?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@map("film_bibles")
}

/// Canonical character profile. AI must mark unknown fields as null, never invent.
model VideoCharacter {
  id                  String       @id @default(uuid())
  videoProjectId      String
  videoProject        VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  name                String
  aliases             String[]     @default([])
  age                 String?
  gender              String?
  physicalAppearance  String?
  clothing            String?
  personality         String?
  role                String?
  characterArc        String?
  referenceImageUrl   String?
  negativePrompt      String?
  continuityNotes     String?
  isFactUnknown       Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([videoProjectId])
  @@map("video_characters")
}

/// Canonical location profile for continuity across scenes.
model VideoLocation {
  id                  String       @id @default(uuid())
  videoProjectId      String
  videoProject        VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  architecture        String?
  environment         String?
  timePeriod          String?
  weatherPatterns     String?
  lightingRules       String?
  visualDescription   String?
  referenceImageUrl   String?
  continuityNotes     String?
  /// Country as stated/implied by the book text (e.g. "Nigeria"). Never
  /// inferred from genre or author nationality — extraction must be
  /// grounded in the actual manuscript. Null when the book doesn't say.
  country             String?
  /// City, village, or named locality from the book (e.g. "Lagos",
  /// "a village outside Enugu"). Null when unspecified.
  city                String?
  /// Broader region/subdivision when the book specifies one but not a
  /// city (e.g. "the Niger Delta", "the Scottish Highlands").
  region              String?
  /// Culturally-specific visual markers actually described in the book
  /// (clothing, architecture, customs, language cues, social context).
  /// This is a fidelity aid, not a stereotype generator — it must only
  /// hold what the text supports, and stays null rather than being
  /// filled with generic assumptions about the country/region.
  culturalContext     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([videoProjectId])
  @@map("video_locations")
}

/// Recurring prop/object with persistent visual description.
model VideoProp {
  id                  String       @id @default(uuid())
  videoProjectId      String
  videoProject        VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  visualDescription   String?
  referenceImageUrl   String?
  continuityNotes     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([videoProjectId])
  @@map("video_props")
}

/// Individual filmable scene. sourceText is the exact manuscript excerpt;
/// narrationText defaults to sourceText and must never silently diverge (§14).
model VideoScene {
  id                    String            @id @default(uuid())
  videoProjectId        String
  videoProject          VideoProject      @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  chapterId             String
  chapter               Chapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  sceneNumber           Int
  sourceText            String
  narrationText         String
  summary               String?
  characters            String[]          @default([])
  location              String?
  props                 String[]          @default([])
  action                String?
  emotionalBeat         String?
  cameraPlan            String?
  visualPrompt          String?
  negativePrompt        String?
  estimatedDurationSec  Float?
  actualDurationSec     Float?
  narrationDurationSec  Float?
  sourceStart           Int?
  sourceEnd             Int?
  status                VideoSceneStatus  @default(PENDING)
  provider              VideoProviderName?
  providerGenerationId  String?
  videoUrl              String?             /// assembled scene master from shots
  audioUrl              String?
  narrationAudioUrl     String?
  subtitleUrl           String?
  thumbnailUrl          String?
  lastErrorType         ProviderErrorType?
  errorMessage          String?
  retryCount            Int               @default(0)
  /// Times this scene has been blocked by pre-generation grounding
  /// validation (invented/unmatched character or location) — distinct
  /// from retryCount, which tracks provider-side failures. Capped
  /// separately since a grounding failure means the scene spec itself
  /// needs a human fix, not another automatic attempt.
  groundingValidationAttempts Int         @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  shots           VideoShot[]
  subtitleCues    SubtitleCue[]
  wordTimestamps  WordTimestamp[]

  @@unique([videoProjectId, chapterId, sceneNumber])
  @@index([videoProjectId])
  @@index([chapterId])
  @@index([status])
  @@index([providerGenerationId])
  @@map("video_scenes")
}


