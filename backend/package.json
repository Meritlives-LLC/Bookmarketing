{
  "name": "bookmarketingos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BookMarketingOS Express.js backend API",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && npm run prisma:seed && node dist/app.js",
    "start:app": "node dist/app.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker:audit": "tsx src/workers/scraper.worker.ts",
    "worker:ai": "tsx src/workers/ai.worker.ts",
    "worker:book-video": "tsx src/workers/book-video.worker.ts",
    "worker:email": "tsx src/workers/email.worker.ts",
    "worker:analytics": "tsx src/workers/analytics.worker.ts",
    "cron": "tsx src/cron/index.ts",
    "start:worker:audit": "node dist/workers/scraper.worker.js",
    "start:worker:ai": "node dist/workers/ai.worker.js",
    "start:worker:book-video": "node dist/workers/book-video.worker.js",
    "start:worker:email": "node dist/workers/email.worker.js",
    "start:worker:analytics": "node dist/workers/analytics.worker.js",
    "start:cron": "node dist/cron/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@prisma/client": "5.7.0",
    "axios": "1.19.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.81.3",
    "cheerio": "^1.0.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "compromise": "^14.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "date-fns": "3.0.6",
    "dotenv": "16.3.1",
    "express": "4.22.2",
    "express-rate-limit": "7.1.5",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "mammoth": "1.12.1",
    "morgan": "1.11.0",
    "multer": "2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.5",
    "pdf-parse": "2.4.5",
    "pg": "8.11.3",
    "rate-limit-redis": "4.2.0",
    "stripe": "14.10.0",
    "uuid": "11.1.1",
    "winston": "3.11.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.5",
    "@types/morgan": "1.9.9",
    "@types/multer": "2.2.0",
    "@types/node": "20.10.6",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "6.4.14",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "8.56.0",
    "jest": "29.7.0",
    "prettier": "3.1.1",
    "prisma": "5.7.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "tsx": "^4.23.12",
    "typescript": "5.3.3"
  }
}
