{
  "name": "bookmarketingos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BookMarketingOS Express.js backend API",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker:audit": "tsx src/workers/scraper.worker.ts",
    "worker:ai": "tsx src/workers/ai.worker.ts",
    "worker:email": "tsx src/workers/email.worker.ts",
    "worker:analytics": "tsx src/workers/analytics.worker.ts",
    "cron": "tsx src/cron/index.ts"
  },
  "dependencies": {
    "express": "4.18.2",
    "@prisma/client": "5.7.0",
    "pg": "8.11.3",
    "ioredis": "5.3.2",
    "bullmq": "5.1.1",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "zod": "3.22.4",
    "cors": "2.8.5",
    "helmet": "7.1.0",
    "express-rate-limit": "7.1.5",
    "rate-limit-redis": "4.2.0",
    "compression": "1.7.4",
    "morgan": "1.10.0",
    "winston": "3.11.0",
    "dotenv": "16.3.1",
    "cookie-parser": "1.4.6",
    "multer": "1.4.5-lts.1",
    "aws-sdk": "2.1541.0",
    "@aws-sdk/client-s3": "3.478.0",
    "@aws-sdk/s3-request-presigner": "3.478.0",
    "stripe": "14.10.0",
    "nodemailer": "6.9.7",
    "openai": "4.24.1",
    "axios": "1.6.5",
    "uuid": "9.0.1",
    "date-fns": "3.0.6",
    "node-cron": "3.0.3"
  },
  "devDependencies": {
    "typescript": "5.3.3",
    "tsx": "4.7.0",
    "prisma": "5.7.0",
    "@types/express": "4.17.21",
    "@types/node": "20.10.6",
    "@types/cors": "2.8.17",
    "@types/compression": "1.7.5",
    "@types/morgan": "1.9.9",
    "@types/cookie-parser": "1.4.6",
    "@types/multer": "1.4.11",
    "@types/nodemailer": "6.4.14",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.5",
    "@types/uuid": "9.0.7",
    "@types/node-cron": "3.0.11",
    "@types/jest": "29.5.11",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "supertest": "6.3.3",
    "eslint": "8.56.0",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "prettier": "3.1.1"
  }
}
