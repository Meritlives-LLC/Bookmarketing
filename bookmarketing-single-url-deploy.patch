diff --git a/render.yaml b/render.yaml
new file mode 100644
index 0000000..35701c5
--- /dev/null
+++ b/render.yaml
@@ -0,0 +1,80 @@
+# Render Blueprint for a single-URL, no-Docker deploy.
+#
+# One web service runs both halves in-process (see root package.json):
+#   - Next.js frontend binds to Render's $PORT and is the only thing
+#     exposed publicly.
+#   - The Express backend binds to a fixed internal port (4000) that is
+#     never exposed — only reachable from inside this same service.
+#   - frontend/next.config.mjs rewrites `/api/*` to BACKEND_INTERNAL_URL
+#     (defaults to http://localhost:4000), and frontend/lib/api/client.ts
+#     calls the API via that same relative path — so the browser only
+#     ever talks to one origin.
+#
+# This intentionally does NOT use `env: docker` / the backend Dockerfile —
+# that image is for docker-compose (local dev) and any container-based
+# hosting you might use instead of this Blueprint. Using this native Node
+# runtime is what gives you one build and one URL instead of two separate
+# image builds/services.
+#
+# After the first deploy, set the secrets below marked `sync: false` in
+# the Render dashboard (Environment tab). CORS_ORIGIN and NEXTAUTH_URL
+# should both be set to this service's own onrender.com URL (or your
+# custom domain) once you know it.
+
+services:
+  - type: web
+    name: bookmarketingos
+    runtime: node
+    plan: starter
+    region: oregon
+    buildCommand: npm run build
+    startCommand: npm run start
+    healthCheckPath: /api/health
+    envVars:
+      - key: NODE_ENV
+        value: production
+      - key: TZ
+        value: Africa/Lagos
+
+      # Backend binds here internally; the frontend rewrite proxies to it.
+      # Must match the fixed port the root "start" script gives the backend.
+      - key: BACKEND_INTERNAL_URL
+        value: http://localhost:4000
+
+      # Same-origin API base — leave this as-is. See lib/api/client.ts.
+      - key: NEXT_PUBLIC_API_URL
+        value: /api/v1
+
+      # --- Set these in the Render dashboard after the first deploy ---
+      - key: DATABASE_URL
+        sync: false
+      - key: JWT_ACCESS_SECRET
+        sync: false
+      - key: JWT_REFRESH_SECRET
+        sync: false
+      - key: CORS_ORIGIN # set to this service's own URL (single-origin deploy)
+        sync: false
+      - key: FRONTEND_URL # same URL as CORS_ORIGIN
+        sync: false
+      - key: NEXTAUTH_URL # same URL again
+        sync: false
+      - key: NEXTAUTH_SECRET
+        sync: false
+
+      # Optional integrations — leave unset to disable, or fill in as needed.
+      - key: REDIS_URL
+        sync: false
+      - key: STRIPE_SECRET_KEY
+        sync: false
+      - key: STRIPE_WEBHOOK_SECRET
+        sync: false
+      - key: AWS_ACCESS_KEY_ID
+        sync: false
+      - key: AWS_SECRET_ACCESS_KEY
+        sync: false
+      - key: GROQ_API_KEY
+        sync: false
+      - key: GEMINI_API_KEY
+        sync: false
+      - key: CLOUDINARY_API_SECRET
+        sync: false
