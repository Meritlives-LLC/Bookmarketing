index 0000000..517df76
--- /dev/null
+++ b/backend/tests/unit/merge-by-name.test.ts
@@ -0,0 +1,57 @@
+import { mergeByName } from '../../src/utils/merge-by-name';
+
+interface Character {
+  name: string;
+  aliases?: string[];
+  appearance?: string | null;
+  isFactUnknown?: boolean;
+}
+
+describe('mergeByName', () => {
+  it('keeps a single occurrence unchanged', () => {
+    const result = mergeByName<Character>([[{ name: 'Peter', appearance: 'tall, scarred hands' }]]);
+    expect(result).toEqual([{ name: 'Peter', appearance: 'tall, scarred hands' }]);
+  });
+
+  // Regression: a character first mentioned with no detail (common on first
+  // appearance) must not permanently stay incomplete once a later chunk
+  // actually describes them — the old implementation discarded this.
+  it('fills in a later chunk\'s detail when the first occurrence had none', () => {
+    const result = mergeByName<Character>([
+      [{ name: 'Peter', appearance: null, isFactUnknown: true }],
+      [{ name: 'Peter', appearance: 'tall, scarred hands', isFactUnknown: false }],
+    ]);
+    expect(result).toEqual([{ name: 'Peter', appearance: 'tall, scarred hands', isFactUnknown: true }]);
+  });
+
+  it('keeps the first occurrence\'s value when both chunks provide one', () => {
+    const result = mergeByName<Character>([
+      [{ name: 'Peter', appearance: 'tall, scarred hands' }],
+      [{ name: 'Peter', appearance: 'a different later description' }],
+    ]);
+    expect(result[0].appearance).toBe('tall, scarred hands');
+  });
+
+  it('unions array fields such as aliases instead of dropping later ones', () => {
+    const result = mergeByName<Character>([
+      [{ name: 'Margaret', aliases: ['Maggie'] }],
+      [{ name: 'Margaret', aliases: ['Meg', 'Maggie'] }],
+    ]);
+    expect(result[0].aliases).toEqual(expect.arrayContaining(['Maggie', 'Meg']));
+    expect(result[0].aliases).toHaveLength(2);
+  });
+
+  it('matches names case-insensitively across chunks', () => {
+    const result = mergeByName<Character>([
+      [{ name: 'peter', appearance: null }],
+      [{ name: 'Peter', appearance: 'tall, scarred hands' }],
+    ]);
+    expect(result).toHaveLength(1);
+    expect(result[0].appearance).toBe('tall, scarred hands');
+  });
+
+  it('keeps distinct names as separate entries', () => {
+    const result = mergeByName<Character>([[{ name: 'Peter' }, { name: 'Mary' }]]);
+    expect(result.map((c) => c.name).sort()).toEqual(['Mary', 'Peter']);
+  });
+});
