diff --git a/backend/src/utils/merge-by-name.ts b/backend/src/utils/merge-by-name.ts
new file mode 100644
index 0000000..626d4ea
--- /dev/null
+++ b/backend/src/utils/merge-by-name.ts
@@ -0,0 +1,42 @@
+/**
+ * Merge multiple chunk-level extraction lists (characters/locations/props)
+ * into one list keyed by name (case-insensitive).
+ *
+ * A book is analyzed in several text chunks, and the same character or
+ * location can be mentioned first with sparse detail (e.g. just a name on
+ * first appearance) and only described fully several chunks later. Naively
+ * keeping only the first occurrence for a given name silently discards that
+ * later, richer detail — the Film Bible ends up with an incomplete
+ * character/location even though the manuscript did describe it.
+ *
+ * This fills in any null/undefined/empty field on the first occurrence from
+ * later occurrences of the same name, and unions array fields (e.g.
+ * aliases), rather than dropping later data outright. Where both
+ * occurrences already have a non-empty value for the same field, the first
+ * occurrence's value is kept (stable, deterministic — not a judgment that
+ * either value is more correct).
+ */
+export function mergeByName<T extends { name: string }>(lists: T[][]): T[] {
+  const map = new Map<string, T>();
+  for (const list of lists) {
+    for (const item of list) {
+      const key = item.name.toLowerCase();
+      const existing = map.get(key);
+      if (!existing) {
+        map.set(key, item);
+        continue;
+      }
+      const merged: Record<string, unknown> = { ...existing };
+      for (const [field, value] of Object.entries(item as Record<string, unknown>)) {
+        const current = merged[field];
+        if (current === null || current === undefined || current === '') {
+          merged[field] = value;
+        } else if (Array.isArray(current) && Array.isArray(value)) {
+          merged[field] = [...new Set([...current, ...value])];
+        }
+      }
+      map.set(key, merged as T);
+    }
+  }
+  return [...map.values()];
+}
diff --git a/backend/tests/unit/merge-by-name.test.ts b/backend/tests/unit/merge-by-name.test.ts
